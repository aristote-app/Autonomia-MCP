# Dedicated Autonomia Supabase project
# Project ref: haazpzbwcryaksgtormn
# Never use Aristote Production credentials here.
NEXT_PUBLIC_SUPABASE_URL=https://haazpzbwcryaksgtormn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Required in production for internal refresh/collector/MCP endpoints.
AUTONOMIA_INTERNAL_TOKEN=

# Used by Vercel Cron as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# FreelanceMention Premium API
FREELANCEMENTION_API_KEY=

# Upwork official GraphQL API (OAuth2)
UPWORK_ACCESS_TOKEN=
UPWORK_TENANT_ID=


# Optional: compliant web-index discovery for public LinkedIn/Indeed job pages.
# Used to detect job/freelance demand signals without scraping those platforms directly.
BRAVE_SEARCH_API_KEY=

# France Travail official Offres emploi v2 API
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
FRANCE_TRAVAIL_SCOPE="api_offresdemploiv2 o2dsoffre"


# Existing paid sales tools. Keep these server-side only.
# Kaspr enrichment should only be triggered after contact qualification.
KASPR_API_KEY=
KASPR_API_BASE_URL=https://api.developers.kaspr.io
# Comma-separated provider field identifiers explicitly authorized for paid retrieval.
# Leave empty to disable Kaspr enrichment even when the API key exists.
KASPR_DATA_TO_GET=

# Waalaxy public API (CRM Sync -> Generate API key)
WAALAXY_API_KEY=
WAALAXY_API_BASE_URL=https://developers.waalaxy.com

# Secret embedded in the Waalaxy CRM Sync on reply webhook URL.
# Generate a long random value; never expose it in client code.
AUTONOMIA_WAALAXY_WEBHOOK_TOKEN=


# Keep false while the cockpit is publicly reachable.
# Enable only after cockpit access control is active.
AUTONOMIA_DECISION_DISCOVERY_ENABLED=false
AUTONOMIA_ACCOUNT_RESEARCH_ENABLED=false


# Optional o2switch self-update endpoint. Keep false until the endpoint has been
# deployed once and AUTONOMIA_INTERNAL_TOKEN is confirmed strong and private.
AUTONOMIA_SELF_DEPLOY_ENABLED=false


# Commercial scheduling timezone.
AUTONOMIA_TIMEZONE=Europe/Paris


# Server-to-server lead ingestion from the public site / landing pages.
AUTONOMIA_INBOUND_TOKEN=
# Set after the private Autonomia workspace exists.
AUTONOMIA_DEFAULT_WORKSPACE_ID=
