NEXT_PUBLIC_SITE_URL=https://autonomia.fr

# Lead forwarding to Autonomia-MCP
AUTONOMIA_INBOUND_URL=https://<autonomia-mcp-host>/api/inbound/leads
AUTONOMIA_INBOUND_TOKEN=

# Read-only aggregated employment signal endpoint exposed by Autonomia-MCP
# Example: https://<autonomia-mcp-host>/api/public/content-signals
AUTONOMIA_CONTENT_SIGNALS_URL=

# Consent-aware analytics
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=


# Optional verified Qualiopi proof. Leave empty until exact wording/entity are validated.
QUALIOPI_PUBLIC_LABEL=
QUALIOPI_CERTIFICATE_URL=


# Organic engine / SEO-GEO operations
INDEXNOW_KEY=
AUTONOMIA_INDEXING_TOKEN=
AUTONOMIA_ORGANIC_TOKEN=
AUTONOMIA_ORGANIC_INSIGHTS_URL=
AUTONOMIA_ORGANIC_INSIGHTS_TOKEN=


# Search engine ownership verification
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=


# Google Search Console API (server-side only)
# Grant this service account access to the Search Console property before use.
# Use the exact Search Console property identifier, for example:
# GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:build-autonomia.com
# or an exact URL-prefix property.
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GOOGLE_SEARCH_CONSOLE_SITEMAP_URL=
GOOGLE_SEARCH_CONSOLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY_ID=
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Preferred: paste the minified Google service-account JSON directly in o2switch.
# Never expose this value client-side and never prefix it with NEXT_PUBLIC_.
GOOGLE_SEARCH_CONSOLE_SERVICE_ACCOUNT_JSON=
